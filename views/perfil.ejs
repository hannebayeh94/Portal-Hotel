<%- include('partials/header') %>
<div class="py-6">
  <div class="max-w-xl mx-auto">
    <div class="card">
      <div class="card-header flex items-center justify-between">
        <h1 class="font-display text-xl text-gray-800"><i class="fas fa-user-shield mr-2 text-primary-600"></i> Mi Perfil y Seguridad</h1>
        <a href="/" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left mr-1"></i> Volver</a>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><i class="fas fa-exclamation-circle mr-2"></i> <%= error %></div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle mr-2"></i> <%= success %></div>
      <% } %>

      <div class="p-4 bg-gray-50 rounded-xl border border-gray-200 mb-6 flex items-center gap-3">
        <div class="w-12 h-12 rounded-full bg-primary-100 text-primary-800 flex items-center justify-center font-bold text-xl">
          <%= (user.nombre || '?').charAt(0).toUpperCase() %>
        </div>
        <div>
          <div class="font-bold text-gray-900"><%= user.nombre %></div>
          <div class="text-xs text-gray-500">Usuario: <span class="font-mono font-medium text-gray-700">@<%= user.username %></span> · Rol: <span class="badge badge-info text-xs"><%= user.rol || 'admin' %></span></div>
        </div>
      </div>

      <h3 class="font-display font-medium text-gray-800 mb-3"><i class="fas fa-key mr-2 text-amber-600"></i> Cambiar Contraseña</h3>
      <form method="POST" action="/perfil/cambiar-password" class="space-y-4">
        <div>
          <label class="form-label text-xs font-semibold text-gray-700">Contraseña Actual *</label>
          <input type="password" name="password_actual" class="form-input" required placeholder="••••••••">
        </div>
        <div>
          <label class="form-label text-xs font-semibold text-gray-700">Nueva Contraseña (mínimo 6 caracteres) *</label>
          <input type="password" name="nueva_password" minlength="6" class="form-input" required placeholder="••••••••">
        </div>
        <div>
          <label class="form-label text-xs font-semibold text-gray-700">Confirmar Nueva Contraseña *</label>
          <input type="password" name="confirmar_password" minlength="6" class="form-input" required placeholder="••••••••">
        </div>
        <div class="pt-2">
          <button type="submit" class="btn btn-primary w-full"><i class="fas fa-lock mr-1.5"></i> Actualizar Contraseña</button>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
