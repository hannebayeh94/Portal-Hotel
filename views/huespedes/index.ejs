<%- include('../partials/header') %>
<div class="py-4">
  <div class="max-w-7xl mx-auto">
    <div class="card">
      <div class="card-header flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h1 class="font-display text-xl"><i class="fas fa-users mr-2 text-primary-600"></i> Directorio de Huéspedes</h1>
          <div class="text-xs text-gray-500 mt-0.5">
            <%= total %> huésped(es) registrado(s)
          </div>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <a href="/huespedes/exportar/csv" class="btn btn-outline btn-sm"><i class="fas fa-file-csv mr-1.5 text-emerald-600"></i> Exportar CSV</a>
          <a href="/huespedes/nuevo" class="btn btn-primary btn-sm"><i class="fas fa-user-plus mr-1.5"></i> Nuevo Huésped</a>
        </div>
      </div>
      <div class="card-body">
        <form method="GET" class="mb-5 flex flex-col sm:flex-row gap-2">
          <div class="relative flex-1">
            <input type="text" name="search" placeholder="Buscar por nombre, apellido, cédula o email..." value="<%= search %>" class="form-input pl-9">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
          </div>
          <div class="flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="fas fa-search mr-1"></i> Buscar</button>
            <% if (search) { %><a href="/huespedes" class="btn btn-outline"><i class="fas fa-times mr-1"></i> Limpiar</a><% } %>
          </div>
        </form>

        <div class="overflow-x-auto">
          <table class="table w-full">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">#</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Nombre Completo</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Cédula</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Email</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Teléfono</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Registro</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% if (huespedes && huespedes.length > 0) { %>
                <% huespedes.forEach(function(h, i) { %>
                  <tr class="border-b border-gray-100">
                    <td class="text-sm font-medium text-gray-700"><%= (page - 1) * 20 + i + 1 %></td>
                    <td class="font-medium"><%= h.nombre %> <%= h.apellido %></td>
                    <td><%= h.numero_cedula %></td>
                    <td><%= h.email || '-' %></td>
                    <td><%= h.telefono || '-' %></td>
                    <td class="text-sm text-gray-500"><%= new Date(h.created_at).toLocaleDateString('es-CO') %></td>
                    <td class="text-right">
                      <a href="/huespedes/<%= h.id %>" class="btn btn-sm btn-outline"><i class="fas fa-eye"></i></a>
                      <a href="/huespedes/<%= h.id %>/editar" class="btn btn-sm btn-outline"><i class="fas fa-edit"></i></a>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="7" class="text-center text-gray-500 py-8">No hay huéspedes registrados</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (totalPages > 1) { %>
<div class="mt-6">
  <nav class="pagination justify-center">
    <% if (page > 1) { %><a href="?page=<%= page - 1 %><%= search ? '&search=' + search : '' %>" class="pagination-link"><i class="fas fa-chevron-left"></i></a><% } %>
    <% for (let p = 1; p <= totalPages; p++) { %><a href="?page=<%= p %><%= search ? '&search=' + search : '' %>" <%= p === page ? 'class="active"' : '' %> class="pagination-link"><%= p %></a><% } %>
    <% if (page < totalPages) { %><a href="?page=<%= page + 1 %><%= search ? '&search=' + search : '' %>" class="pagination-link"><i class="fas fa-chevron-right"></i></a><% } %>
  </nav>
</div>
<% } %>
<%- include('../partials/footer') %>