<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= hotel.nombre %></title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>

<div class="fixed inset-0 bg-black/30 hidden z-40" id="moreBackdrop" onclick="closeMoreSheet()"></div>

<% if (typeof user !== 'undefined' && user) { %>
<div class="app-shell">
  <aside class="sidebar">
    <div class="brand">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-md bg-primary-600 flex items-center justify-center">
          <i class="fas fa-hotel text-white"></i>
        </div>
        <div>
          <h2><%= hotel.nombre %></h2>
          <span>Portal de Gestión</span>
        </div>
      </div>
    </div>
    <nav>
      <a href="/" class="nav-item <%= path === '/' || path === '' ? 'active' : '' %>"><i class="fas fa-chart-pie"></i> Dashboard</a>
      <a href="/checkin" class="nav-item <%= path.startsWith('/checkin') ? 'active' : '' %>"><i class="fas fa-bolt"></i> Check-in Exprés</a>
      <a href="/huespedes" class="nav-item <%= path.startsWith('/huespedes') ? 'active' : '' %>"><i class="fas fa-users"></i> Huéspedes</a>
      <a href="/habitaciones" class="nav-item <%= path.startsWith('/habitaciones') ? 'active' : '' %>"><i class="fas fa-bed"></i> Habitaciones</a>
      <a href="/reservas" class="nav-item <%= path.startsWith('/reservas') ? 'active' : '' %>"><i class="fas fa-calendar-check"></i> Reservas</a>
      <a href="/admin/facturacion" class="nav-item <%= path.includes('/facturacion') ? 'active' : '' %>"><i class="fas fa-file-invoice-dollar"></i> Facturación</a>
      <div class="group-label">Administración</div>
      <a href="/admin/tarifas" class="nav-item <%= path.includes('/tarifas') ? 'active' : '' %>"><i class="fas fa-tags"></i> Tarifas</a>
      <a href="/admin/temporadas" class="nav-item <%= path.includes('/temporadas') ? 'active' : '' %>"><i class="fas fa-calendar-alt"></i> Temporadas</a>
      <a href="/admin/promociones" class="nav-item <%= path.includes('/promociones') ? 'active' : '' %>"><i class="fas fa-percent"></i> Promociones</a>
      <a href="/admin/reportes" class="nav-item <%= path.includes('/reportes') ? 'active' : '' %>"><i class="fas fa-chart-bar"></i> Reportes</a>
    </nav>
    <div class="sidebar-foot">
      <div class="flex items-center gap-2 text-sm">
        <div class="w-8 h-8 rounded-md bg-gray-100 flex items-center justify-center font-medium text-gray-500">
          <%= (user.nombre || '?').charAt(0).toUpperCase() %>
        </div>
        <div>
          <div class="font-medium"><%= user.nombre %></div>
          <div class="text-xs text-gray-400"><%= user.rol || 'Administrador' %></div>
        </div>
      </div>
      <div class="flex gap-2 mt-3">
        <a href="/perfil" class="btn btn-outline btn-sm flex-1 text-center" title="Configurar cuenta"><i class="fas fa-user-cog"></i> Perfil</a>
        <a href="/logout" class="btn btn-danger btn-sm" title="Cerrar Sesión"><i class="fas fa-sign-out-alt"></i></a>
      </div>
    </div>
  </aside>

  <nav class="bottom-nav">
    <a href="/" class="<%= path === '/' || path === '' ? 'active' : '' %>"><i class="fas fa-chart-pie"></i> Inicio</a>
    <a href="/checkin" class="<%= path.startsWith('/checkin') ? 'active' : '' %>"><i class="fas fa-bolt"></i> Check-in</a>
    <a href="/huespedes" class="<%= path.startsWith('/huespedes') ? 'active' : '' %>"><i class="fa fa-users"></i> Huéspedes</a>
    <a href="/reservas" class="<%= path.startsWith('/reservas') ? 'active' : '' %>"><i class="fas fa-calendar-check"></i> Reservas</a>
    <button type="button" onclick="openMoreSheet()"><i class="fas fa-ellipsis-v"></i></button>
  </nav>

  <main class="main-content">
<% } else { %>
    <main>
<% } %>
