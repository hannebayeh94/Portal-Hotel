<%- include('../partials/header') %>
<div class="topbar">
  <h1><i class="fas fa-<%= habitacion && habitacion.id ? 'edit' : 'plus-square' %>" style="color:#1f4d3a"></i> <%= habitacion && habitacion.id ? 'Editar Habitación' : 'Nueva Habitación' %></h1>
  <a href="/habitaciones" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Volver</a>
</div>

<div class="card" style="max-width:700px;">
  <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>
  <form method="POST" action="<%= habitacion && habitacion.id ? '/habitaciones/' + habitacion.id + '/editar' : '/habitaciones/nueva' %>">
    <div class="grid-2">
      <div class="form-group">
        <label>Número de Habitación *</label>
        <input type="text" name="numero" class="form-control" value="<%= habitacion ? habitacion.numero : '' %>" required>
      </div>
      <div class="form-group">
        <label>Tipo *</label>
        <select name="tipo" class="form-control" required>
          <option value="individual" <%= habitacion && habitacion.tipo === 'individual' ? 'selected' : '' %>>Individual</option>
          <option value="doble" <%= habitacion && habitacion.tipo === 'doble' ? 'selected' : '' %>>Doble</option>
          <option value="suite" <%= habitacion && habitacion.tipo === 'suite' ? 'selected' : '' %>>Suite</option>
          <option value="familiar" <%= habitacion && habitacion.tipo === 'familiar' ? 'selected' : '' %>>Familiar</option>
          <option value="presidencial" <%= habitacion && habitacion.tipo === 'presidencial' ? 'selected' : '' %>>Presidencial</option>
        </select>
      </div>
    </div>
    <div class="grid-2">
      <div class="form-group">
        <label>Precio Base por Noche *</label>
        <input type="number" name="precio_base" class="form-control" step="1000" value="<%= habitacion ? habitacion.precio_base : '' %>" required>
      </div>
      <div class="form-group">
        <label>Capacidad</label>
        <input type="number" name="capacidad" class="form-control" min="1" value="<%= habitacion ? habitacion.capacidad : '2' %>">
      </div>
    </div>
    <div class="form-group">
      <label>Descripción</label>
      <textarea name="descripcion" class="form-control" rows="3"><%= habitacion ? habitacion.descripcion : '' %></textarea>
    </div>
    <div class="form-group">
      <label>Servicios (separados por coma)</label>
      <input type="text" name="servicios" class="form-control" placeholder="TV, WiFi, Aire acondicionado..." value="<%= habitacion ? (typeof habitacion.servicios === 'string' ? JSON.parse(habitacion.servicios).join(', ') : '') : '' %>">
    </div>
    <% if (habitacion && habitacion.id) { %>
    <div class="form-group">
      <label>Estado</label>
      <select name="estado" class="form-control">
        <option value="disponible" <%= habitacion.estado === 'disponible' ? 'selected' : '' %>>Disponible</option>
        <option value="ocupado" <%= habitacion.estado === 'ocupado' ? 'selected' : '' %>>Ocupado</option>
        <option value="mantenimiento" <%= habitacion.estado === 'mantenimiento' ? 'selected' : '' %>>Mantenimiento</option>
        <option value="reservada" <%= habitacion.estado === 'reservada' ? 'selected' : '' %>>Reservada</option>
      </select>
    </div>
    <% } %>
    <div style="display:flex; gap:0.5rem; margin-top:1rem;">
      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= habitacion && habitacion.id ? 'Actualizar' : 'Guardar' %></button>
      <a href="/habitaciones" class="btn btn-outline">Cancelar</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
