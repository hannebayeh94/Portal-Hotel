<%- include('../partials/header') %>
<div class="py-4">
  <div class="max-w-7xl mx-auto">
    <div class="card">
      <div class="card-header flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h1 class="font-display text-xl"><i class="fas fa-bed mr-2 text-primary-600"></i> Inventario de Habitaciones</h1>
          <div class="text-xs text-gray-500 mt-0.5">
            <%= total %> habitaciones registradas
          </div>
        </div>
        <div class="flex items-center gap-2">
          <a href="/habitaciones/nueva" class="btn btn-primary btn-sm"><i class="fas fa-plus mr-1.5"></i> Nueva Habitación</a>
          <% if (filtros.tipo || filtros.estado || filtros.precio_min || filtros.precio_max) { %>
            <a href="/habitaciones" class="btn btn-outline btn-sm"><i class="fas fa-times mr-1"></i> Quitar Filtros</a>
          <% } %>
        </div>
      </div>
      <div class="card-body">
        <form method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 mb-6 p-4 bg-gray-50 rounded-xl border border-gray-200">
          <div>
            <label for="filtroTipo" class="form-label text-xs font-semibold text-gray-600 mb-1">Tipo</label>
            <select name="tipo" id="filtroTipo" class="form-select text-sm py-1.5">
              <option value="">Todos los tipos</option>
              <% tipos.forEach(function(t) { %>
                <option value="<%= t.tipo %>" <%= filtros.tipo === t.tipo ? 'selected' : '' %>><%= t.tipo.charAt(0).toUpperCase() + t.tipo.slice(1) %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label for="filtroEstado" class="form-label text-xs font-semibold text-gray-600 mb-1">Estado</label>
            <select name="estado" id="filtroEstado" class="form-select text-sm py-1.5">
              <option value="">Todos los estados</option>
              <option value="disponible" <%= filtros.estado === 'disponible' ? 'selected' : '' %>>Disponible</option>
              <option value="ocupado" <%= filtros.estado === 'ocupado' ? 'selected' : '' %>>Ocupado</option>
              <option value="mantenimiento" <%= filtros.estado === 'mantenimiento' ? 'selected' : '' %>>Mantenimiento / Limpieza</option>
              <option value="reservada" <%= filtros.estado === 'reservada' ? 'selected' : '' %>>Reservada</option>
            </select>
          </div>
          <div>
            <label class="form-label text-xs font-semibold text-gray-600 mb-1">Precio mínimo</label>
            <input type="number" name="precio_min" class="form-input text-sm py-1.5" placeholder="$ Mínimo" value="<%= filtros.precio_min || '' %>">
          </div>
          <div>
            <label class="form-label text-xs font-semibold text-gray-600 mb-1">Precio máximo</label>
            <input type="number" name="precio_max" class="form-input text-sm py-1.5" placeholder="$ Máximo" value="<%= filtros.precio_max || '' %>">
          </div>
          <div class="flex items-end gap-2">
            <button type="submit" class="btn btn-primary w-full py-2"><i class="fas fa-search mr-1"></i> Filtrar</button>
            <a href="/habitaciones" class="btn btn-outline py-2"><i class="fas fa-undo"></i></a>
          </div>
        </form>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          <% if (habitaciones && habitaciones.length > 0) { %>
            <% habitaciones.forEach(function(h) { %>
              <div class="rounded-xl border bg-white shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between overflow-hidden border-gray-200">
                <div class="p-4 border-b border-gray-100 flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="w-10 h-10 rounded-lg bg-primary-50 text-primary-700 flex items-center justify-center font-bold text-lg">
                      <%= h.numero %>
                    </span>
                    <div>
                      <div class="text-xs font-bold uppercase tracking-wider text-gray-400">Habitación</div>
                      <span class="badge <%= h.tipo === 'suite' || h.tipo === 'presidencial' ? 'badge-warning' : 'badge-info' %> text-xs">
                        <%= h.tipo.charAt(0).toUpperCase() + h.tipo.slice(1) %>
                      </span>
                    </div>
                  </div>
                  <div>
                    <% if (h.estado === 'disponible') { %>
                      <span class="badge badge-success"><i class="fas fa-check-circle mr-1"></i> Disponible</span>
                    <% } else if (h.estado === 'ocupado') { %>
                      <span class="badge badge-danger"><i class="fas fa-user mr-1"></i> Ocupada</span>
                    <% } else if (h.estado === 'reservada') { %>
                      <span class="badge badge-warning"><i class="fas fa-clock mr-1"></i> Reservada</span>
                    <% } else { %>
                      <span class="badge badge-gray text-amber-800 bg-amber-100"><i class="fas fa-broom mr-1"></i> Mantenimiento</span>
                    <% } %>
                  </div>
                </div>

                <div class="p-4 flex-1">
                  <div class="flex items-baseline justify-between mb-3">
                    <div>
                      <span class="text-2xl font-extrabold text-gray-900">$<%= Number(h.precio_base).toLocaleString('es-CO') %></span>
                      <span class="text-xs text-gray-500 font-medium">/ noche</span>
                    </div>
                    <div class="text-xs text-gray-500 flex items-center gap-1">
                      <i class="fas fa-user-friends text-gray-400"></i> <%= h.capacidad %> personas
                    </div>
                  </div>

                  <% if (h.descripcion) { %>
                    <p class="text-xs text-gray-500 line-clamp-2 mb-3"><%= h.descripcion %></p>
                  <% } %>
                </div>

                <div class="p-3 bg-gray-50 border-t border-gray-100 flex items-center justify-between gap-2">
                  <a href="/habitaciones/<%= h.id %>" class="btn btn-outline btn-sm flex-1 text-center"><i class="fas fa-eye mr-1"></i> Detalles</a>
                  <% if (h.estado === 'mantenimiento') { %>
                    <form method="POST" action="/habitaciones/<%= h.id %>/estado" class="inline">
                      <input type="hidden" name="nuevo_estado" value="disponible">
                      <button type="submit" class="btn btn-success btn-sm" title="Marcar como lista para ocupar"><i class="fas fa-check mr-1"></i> Lista</button>
                    </form>
                  <% } else if (h.estado === 'disponible') { %>
                    <form method="POST" action="/habitaciones/<%= h.id %>/estado" class="inline">
                      <input type="hidden" name="nuevo_estado" value="mantenimiento">
                      <button type="submit" class="btn btn-outline btn-sm text-amber-700" title="Poner en limpieza o mantenimiento"><i class="fas fa-broom"></i></button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="col-span-full text-center text-gray-500 py-12 card">No se encontraron habitaciones con los criterios seleccionados.</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>