<%- include('../partials/header') %>
<div class="py-4">
  <div class="max-w-7xl mx-auto">
    <div class="card">
      <div class="card-header flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        <h1 class="font-display text-xl"><i class="fas fa-chart-bar mr-2 text-primary-600"></i> Reportes y Estadísticas</h1>
        <form method="GET" action="/admin/reportes" class="flex flex-wrap items-center gap-2">
          <div class="flex items-center gap-1.5">
            <label class="text-xs text-gray-500 font-medium">Desde:</label>
            <input type="date" name="desde" id="filtroDesde" class="form-input text-sm py-1 px-2" value="<%= desde %>">
          </div>
          <div class="flex items-center gap-1.5">
            <label class="text-xs text-gray-500 font-medium">Hasta:</label>
            <input type="date" name="hasta" id="filtroHasta" class="form-input text-sm py-1 px-2" value="<%= hasta %>">
          </div>
          <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-filter mr-1"></i> Filtrar</button>
        </form>
      </div>

      <div class="card-body">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
          <% if (ingresos) { %>
            <div class="stat-card">
              <div class="text-xs font-semibold text-gray-500 uppercase">Ingresos del Período</div>
              <div class="text-2xl font-bold text-primary-700">$<%= Number(ingresos.total).toLocaleString('es-CO') %></div>
              <div class="text-xs text-gray-400">Facturado y pagado</div>
            </div>
            <div class="stat-card">
              <div class="text-xs font-semibold text-gray-500 uppercase">Facturas Pagadas</div>
              <div class="text-2xl font-bold text-gray-800"><%= ingresos.count %></div>
              <div class="text-xs text-gray-400">En el período seleccionado</div>
            </div>
            <div class="stat-card">
              <div class="text-xs font-semibold text-gray-500 uppercase">Ocupación Actual</div>
              <div class="text-2xl font-bold text-amber-600"><%= totalHab > 0 ? Math.round((ocupacion.ocupadas / totalHab) * 100) : 0 %>%</div>
              <div class="text-xs text-gray-400">Tiempo real</div>
            </div>
            <div class="stat-card">
              <div class="text-xs font-semibold text-gray-500 uppercase">Habitaciones Ocupadas</div>
              <div class="text-2xl font-bold text-emerald-600"><%= ocupacion.ocupadas %> <span class="text-sm font-normal text-gray-500">/ <%= totalHab %></span></div>
              <div class="text-xs text-gray-400">Total en inventario</div>
            </div>
          <% } %>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
          <div class="card bg-white p-4 border border-gray-200">
            <h3 class="font-medium text-gray-800 mb-3"><i class="fas fa-chart-line text-primary-600 mr-1.5"></i> Ingresos Mensuales</h3>
            <div style="height:280px;">
              <canvas id="chartIngresos"></canvas>
            </div>
          </div>
          <div class="card bg-white p-4 border border-gray-200">
            <h3 class="font-medium text-gray-800 mb-3"><i class="fas fa-chart-pie text-emerald-600 mr-1.5"></i> Ocupación por Tipo de Habitación</h3>
            <div style="height:280px;">
              <canvas id="chartOcupacion"></canvas>
            </div>
          </div>
        </div>

        <div class="mt-4">
          <div class="rounded-md border p-3 text-sm text-gray-600">
            <h3 class="font-medium text-gray-700 mb-2">Reservas del Período</h3>
            <div class="overflow-x-auto">
              <table class="table w-full">
                <thead>
                  <tr class="border-b border-gray-200">
                    <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">#</th>
                    <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Huésped</th>
                    <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Habitación</th>
                    <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Entrada</th>
                    <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Salida</th>
                    <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Total</th>
                    <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Estado</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (reservasPeriodo && reservasPeriodo.length > 0) { %>
                    <% reservasPeriodo.forEach(function(r) { %>
                      <tr class="border-b border-gray-100">
                        <td class="text-sm font-medium text-gray-700"><%= r.id %></td>
                        <td class="font-medium"><%= r.nombre %> <%= r.apellido %></td>
                        <td><%= r.hab_numero %> (<%= r.hab_tipo %>)</td>
                        <td><%= new Date(r.fecha_entrada).toLocaleDateString('es-CO') %></td>
                        <td><%= new Date(r.fecha_salida).toLocaleDateString('es-CO') %></td>
                        <td><strong>$<%= Number(r.precio_total).toLocaleString('es-CO') %></strong></td>
                        <td>
                          <% if (r.estado === 'pendiente') { %><span class="badge bg-amber-100 text-amber-800 text-xs">Pendiente</span><% } %>
                          <% if (r.estado === 'confirmada') { %><span class="badge bg-blue-100 text-blue-800 text-xs">Confirmada</span><% } %>
                          <% if (r.estado === 'checkin') { %><span class="badge bg-green-100 text-green-800 text-xs">Check-in</span><% } %>
                          <% if (r.estado === 'checkout') { %><span class="badge bg-gray-100 text-gray-600 text-xs">Check-out</span><% } %>
                          <% if (r.estado === 'cancelada') { %><span class="badge bg-red-100 text-red-800 text-xs">Cancelada</span><% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td colspan="7" class="text-center text-gray-500 py-4">No hay reservas en este período</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
<% if (ingresosPorMes && ingresosPorMes.length > 0) { 
  const mesesCronologicos = [...ingresosPorMes].reverse();
%>
new Chart(document.getElementById('chartIngresos'), {
  type: 'bar',
  data: {
    labels: [<% mesesCronologicos.forEach(function(m) { %>'<%= m.mes %>',<% }) %>],
    datasets: [{
      label: 'Ingresos ($)',
      data: [<% mesesCronologicos.forEach(function(m) { %><%= m.total %>,<% }) %>],
      backgroundColor: '#1f4d3a',
      borderRadius: 6
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: { y: { beginAtZero: true, ticks: { callback: function(v) { return '$' + v.toLocaleString('es-CO'); } } } }
  }
});
<% } %>
<% if (ocupacionPorTipo && ocupacionPorTipo.length > 0) { %>
new Chart(document.getElementById('chartOcupacion'), {
  type: 'doughnut',
  data: {
    labels: [<% ocupacionPorTipo.forEach(function(t) { %>'<%= t.tipo.charAt(0).toUpperCase() + t.tipo.slice(1) %>',<% }) %>],
    datasets: [{
      data: [<% ocupacionPorTipo.forEach(function(t) { %><%= t.ocupadas %>,<% }) %>],
      backgroundColor: ['#1f4d3a','#059669','#d97706','#9333ea','#dc2626']
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { position: 'bottom' }
    }
  }
});
<% } %>
</script>
<%- include('../partials/footer') %>