<%- include('../partials/header') %>
<div class="py-4">
  <div class="max-w-7xl mx-auto">
    <div class="card">
      <div class="card-header flex flex-col sm:flex-row justify-between items-start gap-3">
        <h1 class="font-display text-xl"><i class="fas fa-percent mr-2 text-primary-600"></i> Promociones</h1>
        <button class="btn btn-primary" onclick="document.getElementById('modalPromo').classList.add('active')"><i class="fas fa-plus"></i> Nueva Promoción</button>
      </div>

      <div class="card-body">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error rounded-md p-3 text-sm text-red-700 mb-4"> <%= error %> </div>
        <% } %>

        <div class="overflow-x-auto mb-4">
          <table class="table w-full">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Nombre</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Código</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Descuento</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Vigencia</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Estado</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Acción</th>
              </tr>
            </thead>
            <tbody>
              <% promociones.forEach(function(p) { %>
                <tr class="border-b border-gray-100">
                  <td><strong><%= p.nombre %></strong></td>
                  <td><span class="bg-blue-100 text-blue-800 text-xs font-medium"><%= p.codigo || '-' %></span></td>
                  <td class="font-medium"><%= p.descuento %></td>
                  <td class="text-sm"><%= p.fecha_inicio ? new Date(p.fecha_inicio).toLocaleDateString('es-CO') : 'Siempre' %> - <%= p.fecha_fin ? new Date(p.fecha_fin).toLocaleDateString('es-CO') : 'Siempre' %></td>
                  <td><span class="<%= p.activo ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600' %>" text-xs><%= p.activo ? 'Activo' : 'Inactivo' %></span></td>
                  <td class="text-right">
                    <form method="POST" action="/admin/promociones/<%= p.id %>/toggle">
                      <button type="submit" class="btn btn-sm <%= p.activo ? 'btn-warning' : 'btn-success' %>"><i class="fas <%= p.activo ? 'fa-pause' : 'fa-play' %>"></i></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="mt-4">
          <div class="rounded-md border p-3 text-sm text-gray-600 mb-4">Las promociones se aplican automáticamente al calcular el precio total de una reserva. El descuento se normaliza a porcentaje.</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="modalPromo" class="modal hidden">
  <div class="modal-content bg-white rounded-lg border p-6 w-full max-w-md shadow-lg">
    <button class="absolute top-3 right-3 rounded-full p-1 hover:bg-gray-100 text-gray-400" onclick="this.closest('.modal').classList.remove('active')">&times;</button>
    <h3 class="text-lg font-medium text-gray-900 mb-4">Nueva Promoción</h3>
    <form method="POST" action="/admin/promociones/nueva">
      <div class="grid grid-cols-1 gap-4">
        <div>
          <label for="nombrePromo" class="form-label text-sm font-medium text-gray-700">Nombre *</label>
          <input type="text" name="nombre" id="nombrePromo" required class="form-input block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9">
        </div>
        <div>
          <label for="codigoPromo" class="form-label text-sm font-medium text-gray-700">Código (único) *</label>
          <input type="text" name="codigo" id="codigoPromo" required class="form-input block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9" placeholder="PROMO10">
        </div>
      </div>
      <div class="grid grid-cols-1 gap-4">
        <div>
          <label for="descripcionPromo" class="form-label text-sm font-medium text-gray-700">Descripción</label>
          <textarea name="descripcion" rows="2" class="form-input block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9"></textarea>
        </div>
        <div>
          <label for="descuentoPromo" class="form-label text-sm font-medium text-gray-700">Descuento *</label>
          <input type="number" name="descuento" id="descuentoPromo" required class="form-input block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9" step="0.01">
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="tipoDescuento" class="form-label text-sm font-medium text-gray-700">Tipo</label>
          <select name="tipo_descuento" id="tipoDescuento" class="form-select block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9">
            <option value="porcentaje">Porcentaje (%)</option>
            <option value="fijo">Valor Fijo ($)</option>
          </select>
        </div>
        <div>
          <label for="fechaInicioPromo" class="form-label text-sm font-medium text-gray-700">Fecha Inicio</label>
          <input type="date" name="fecha_inicio" id="fechaInicioPromo" class="form-input block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9">
        </div>
        <div>
          <label for="fechaFinPromo" class="form-label text-sm font-medium text-gray-700">Fecha Fin</label>
          <input type="date" name="fecha_fin" id="fechaFinPromo" class="form-input block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9">
        </div>
      </div>
      <div class="mt-4 flex justify-end gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="button" class="btn btn-outline" onclick="this.closest('.modal').classList.remove('active')">Cancelar</button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>