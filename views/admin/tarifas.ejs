<%- include('../partials/header') %>
<div class="py-4">
  <div class="max-w-7xl mx-auto">
    <div class="card">
      <div class="card-header flex flex-col sm:flex-row justify-between items-start gap-3">
        <h1 class="font-display text-xl"><i class="fas fa-tags mr-2 text-primary-600"></i> Administración de Tarifas</h1>
        <button class="btn btn-primary" onclick="document.getElementById('modalTarifa').classList.add('active')"><i class="fas fa-plus"></i> Nueva Tarifa</button>
      </div>

      <div class="card-body">
        <div class="overflow-x-auto mb-4">
          <table class="table w-full">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Tipo</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Temporada</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Precio</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Vigencia</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Acción</th>
              </tr>
            </thead>
            <tbody>
              <% if (tarifas && tarifas.length > 0) { %>
                <% tarifas.forEach(function(t) { %>
                  <tr class="border-b border-gray-100">
                    <td class="font-medium"><%= t.tipo_habitacion %></td>
                    <td><%= t.temporada_nombre || 'General' %></td>
                    <td><strong>$<%= Number(t.precio).toLocaleString('es-CO') %></strong></td>
                    <td class="text-sm"><%= t.fecha_inicio || '-' %> / <%= t.fecha_fin || '-' %></td>
                    <td class="text-right">
                      <form method="POST" action="/admin/tarifas/<%= t.id %>/eliminar" onsubmit="return confirm('¿Eliminar esta tarifa?')">
                        <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="5" class="text-center text-gray-500 py-4">No hay tarifas personalizadas. Se usan los precios base de las habitaciones.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="mt-4">
          <div class="badge bg-blue-100 text-blue-800 text-sm font-medium mb-3 block">Precios Base por Tipo</div>
          <table class="table w-full">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Tipo</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Precio Base</th>
              </tr>
            </thead>
            <tbody>
              <% tipos.forEach(function(t) { %>
                <tr class="border-b border-gray-100">
                  <td class="font-medium"><%= t.tipo.charAt(0).toUpperCase() + t.tipo.slice(1) %></td>
                  <td><strong>$<%= Number(habitaciones_precios && habitaciones_precios[t.tipo] ? habitaciones_precios[t.tipo] : '0').toLocaleString('es-CO') %></strong></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="modalTarifa" class="modal hidden">
  <div class="modal-content bg-white rounded-lg border p-6 w-full max-w-md shadow-lg">
    <button class="absolute top-3 right-3 rounded-full p-1 hover:bg-gray-100 text-gray-400" onclick="this.closest('.modal').classList.remove('active')">&times;</button>
    <h3 class="text-lg font-medium text-gray-900 mb-4">Nueva Tarifa</h3>
    <form method="POST" action="/admin/tarifas/nueva">
      <div>
        <label for="tipoTarifa" class="form-label text-sm font-medium text-gray-700">Tipo de Habitación</label>
        <select name="tipo_habitacion" id="tipoTarifa" required class="form-select block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9">
          <% tipos.forEach(function(t) { %>
            <option value="<%= t.tipo %>"><%= t.tipo.charAt(0).toUpperCase() + t.tipo.slice(1) %></option>
          <% }) %>
        </select>
      </div>
      <div class="mt-3">
        <label for="temporadaTarifa" class="form-label text-sm font-medium text-gray-700">Temporada</label>
        <select name="temporada_id" id="temporadaTarifa" class="form-select block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9">
          <option value="">General</option>
          <% temporadas.forEach(function(s) { %>
            <option value="<%= s.id %>"><%= s.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="mt-3">
        <label for="precioTarifa" class="form-label text-sm font-medium text-gray-700">Precio por Noche</label>
        <input type="number" name="precio" id="precioTarifa" required class="form-input block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9" step="1000">
      </div>
      <div class="grid grid-cols-2 gap-3 mt-4">
        <div>
          <label for="fechaInicioTarifa" class="form-label text-sm font-medium text-gray-700">Fecha Inicio</label>
          <input type="date" name="fecha_inicio" id="fechaInicioTarifa" class="form-input block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9">
        </div>
        <div>
          <label for="fechaFinTarifa" class="form-label text-sm font-medium text-gray-700">Fecha Fin</label>
          <input type="date" name="fecha_fin" id="fechaFinTarifa" class="form-input block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9">
        </div>
      </div>
      <div class="mt-4 flex justify-end gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="button" class="btn btn-outline" onclick="this.closest('.modal').classList.remove('active')">Cancelar</button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>