<%- include('../partials/header') %>
<div class="topbar">
  <h1><i class="fas fa-tags" style="color:#1f4d3a"></i> Administración de Tarifas</h1>
</div>

<div class="tabs">
  <a href="/admin/tarifas" class="active">Tarifas</a>
  <a href="/admin/temporadas">Temporadas</a>
  <a href="/admin/promociones">Promociones</a>
  <a href="/admin/reportes">Reportes</a>
  <a href="/admin/facturacion">Facturación</a>
</div>

<div class="card">
  <div class="card-header">
    <h3>Tarifas por Tipo de Habitación</h3>
    <button class="btn btn-primary btn-sm" onclick="document.getElementById('modalTarifa').classList.add('active')"><i class="fas fa-plus"></i> Nueva Tarifa</button>
  </div>
  <div class="table-container">
    <table>
      <thead><tr><th>Tipo</th><th>Temporada</th><th>Precio</th><th>Vigencia</th><th>Acción</th></tr></thead>
      <tbody>
        <% if (tarifas && tarifas.length > 0) { %>
          <% tarifas.forEach(function(t) { %>
          <tr>
            <td><span class="badge badge-info"><%= t.tipo_habitacion %></span></td>
            <td><%= t.temporada_nombre || 'General' %></td>
            <td><strong>$<%= Number(t.precio).toLocaleString('es-CO') %></strong></td>
            <td class="text-sm"><%= t.fecha_inicio || '-' %> / <%= t.fecha_fin || '-' %></td>
            <td>
              <form method="POST" action="/admin/tarifas/<%= t.id %>/eliminar" style="display:inline;" onsubmit="return confirm('¿Eliminar esta tarifa?')">
                <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5" class="text-center text-muted">No hay tarifas personalizadas. Se usan los precios base de las habitaciones.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <div class="card-header"><h3>Precios Base por Tipo</h3></div>
  <div class="table-container">
    <table>
      <thead><tr><th>Tipo</th><th>Precio Base</th></tr></thead>
      <tbody>
        <% tipos.forEach(function(t) { %>
          <tr><td><%= t.tipo.charAt(0).toUpperCase() + t.tipo.slice(1) %></td><td>$<%= Number(habitaciones_precios && habitaciones_precios[t.tipo] ? habitaciones_precios[t.tipo] : '0').toLocaleString('es-CO') %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div id="modalTarifa" class="modal">
  <div class="modal-content">
    <button class="modal-close" onclick="this.closest('.modal').classList.remove('active')">&times;</button>
    <h3 style="margin-bottom:1.5rem;">Nueva Tarifa</h3>
    <form method="POST" action="/admin/tarifas/nueva">
      <div class="form-group">
        <label>Tipo de Habitación</label>
        <select name="tipo_habitacion" class="form-control" required>
          <% tipos.forEach(function(t) { %>
            <option value="<%= t.tipo %>"><%= t.tipo.charAt(0).toUpperCase() + t.tipo.slice(1) %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Temporada</label>
        <select name="temporada_id" class="form-control">
          <option value="">General</option>
          <% temporadas.forEach(function(s) { %>
            <option value="<%= s.id %>"><%= s.nombre %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Precio por Noche</label>
        <input type="number" name="precio" class="form-control" step="1000" required>
      </div>
      <div class="grid-2">
        <div class="form-group">
          <label>Fecha Inicio</label>
          <input type="date" name="fecha_inicio" class="form-control">
        </div>
        <div class="form-group">
          <label>Fecha Fin</label>
          <input type="date" name="fecha_fin" class="form-control">
        </div>
      </div>
      <div style="display:flex; gap:0.5rem; margin-top:1rem;">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar</button>
        <button type="button" class="btn btn-outline" onclick="document.getElementById('modalTarifa').classList.remove('active')">Cancelar</button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
