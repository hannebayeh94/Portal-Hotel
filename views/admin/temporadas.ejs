<%- include('../partials/header') %>
<div class="py-4">
  <div class="max-w-7xl mx-auto">
    <div class="card">
      <div class="card-header flex flex-col sm:flex-row justify-between items-start gap-3">
        <h1 class="font-display text-xl"><i class="fas fa-calendar-alt mr-2 text-primary-600"></i> Temporadas</h1>
        <button class="btn btn-primary" onclick="document.getElementById('modalTemp').classList.add('active')"><i class="fas fa-plus"></i> Nueva Temporada</button>
      </div>

      <div class="card-body">
        <div class="overflow-x-auto mb-4">
          <table class="table w-full">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Nombre</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Inicio</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Fin</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Multiplicador</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Estado</th>
                <th class="text-left text-xs font-medium text-gray-500 uppercase py-3">Acción</th>
              </tr>
            </thead>
            <tbody>
              <% temporadas.forEach(function(t) { %>
                <tr class="border-b border-gray-100">
                  <td><strong><%= t.nombre %></strong></td>
                  <td><%= new Date(t.fecha_inicio).toLocaleDateString('es-CO') %></td>
                  <td><%= new Date(t.fecha_fin).toLocaleDateString('es-CO') %></td>
                  <td class="font-medium"><%= t.multiplicador %>x</td>
                  <td><span class="<%= t.activo ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600' %>" text-xs><%= t.activo ? 'Activo' : 'Inactivo' %></span></td>
                  <td class="text-right">
                    <form method="POST" action="/admin/temporadas/<%= t.id %>/eliminar" onsubmit="return confirm('¿Eliminar esta temporada?')">
                      <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="modalTemp" class="modal hidden">
  <div class="modal-content bg-white rounded-lg border p-6 w-full max-w-md shadow-lg">
    <button class="absolute top-3 right-3 rounded-full p-1 hover:bg-gray-100 text-gray-400" onclick="this.closest('.modal').classList.remove('active')">&times;</button>
    <h3 class="text-lg font-medium text-gray-900 mb-4">Nueva Temporada</h3>
    <form method="POST" action="/admin/temporadas/nueva">
      <div>
        <label for="nombreTemp" class="form-label text-sm font-medium text-gray-700">Nombre de la Temporada</label>
        <input type="text" name="nombre" id="nombreTemp" required class="form-input block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9">
      </div>
      <div class="mt-3">
        <label for="fechaInicioTemp" class="form-label text-sm font-medium text-gray-700">Fecha Inicio</label>
        <input type="date" name="fecha_inicio" id="fechaInicioTemp" required class="form-input block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9">
      </div>
      <div class="mt-3">
        <label for="fechaFinTemp" class="form-label text-sm font-medium text-gray-700">Fecha Fin</label>
        <input type="date" name="fecha_fin" id="fechaFinTemp" required class="form-input block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9">
      </div>
      <div class="mt-3">
        <label for="multiplicadorTemp" class="form-label text-sm font-medium text-gray-700">Multiplicador de Precio</label>
        <input type="number" name="multiplicador" id="multiplicadorTemp" required class="form-input block w-full rounded-md border-gray-300 shadow-sm py-2.5 ps-3 pr-9" step="0.05" value="1.0">
        <div class="text-sm text-gray-500 mt-1">Ej: 1.25 = 25% más caro, 0.85 = 15% descuento</div>
      </div>
      <div class="mt-4 flex justify-end gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="button" class="btn btn-outline" onclick="this.closest('.modal').classList.remove('active')">Cancelar</button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>