<%- include('../partials/header') %>
<div class="topbar">
  <h1><i class="fas fa-calendar-alt" style="color:#1f4d3a"></i> Temporadas</h1>
</div>

<div class="tabs">
  <a href="/admin/tarifas">Tarifas</a>
  <a href="/admin/temporadas" class="active">Temporadas</a>
  <a href="/admin/promociones">Promociones</a>
  <a href="/admin/reportes">Reportes</a>
  <a href="/admin/facturacion">Facturación</a>
</div>

<div class="card">
  <div class="card-header">
    <h3>Temporadas del Año</h3>
    <button class="btn btn-primary btn-sm" onclick="document.getElementById('modalTemp').classList.add('active')"><i class="fas fa-plus"></i> Nueva Temporada</button>
  </div>
  <div class="table-container">
    <table>
      <thead><tr><th>Nombre</th><th>Inicio</th><th>Fin</th><th>Multiplicador</th><th>Estado</th><th>Acción</th></tr></thead>
      <tbody>
        <% temporadas.forEach(function(t) { %>
        <tr>
          <td><strong><%= t.nombre %></strong></td>
          <td><%= new Date(t.fecha_inicio).toLocaleDateString('es-CO') %></td>
          <td><%= new Date(t.fecha_fin).toLocaleDateString('es-CO') %></td>
          <td><%= t.multiplicador %>x</td>
          <td><span class="badge <%= t.activo ? 'badge-success' : 'badge-gray' %>"><%= t.activo ? 'Activo' : 'Inactivo' %></span></td>
          <td>
            <form method="POST" action="/admin/temporadas/<%= t.id %>/eliminar" style="display:inline;" onsubmit="return confirm('¿Eliminar esta temporada?')">
              <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div id="modalTemp" class="modal">
  <div class="modal-content">
    <button class="modal-close" onclick="this.closest('.modal').classList.remove('active')">&times;</button>
    <h3 style="margin-bottom:1.5rem;">Nueva Temporada</h3>
    <form method="POST" action="/admin/temporadas/nueva">
      <div class="form-group">
        <label>Nombre de la Temporada</label>
        <input type="text" name="nombre" class="form-control" required>
      </div>
      <div class="grid-2">
        <div class="form-group">
          <label>Fecha Inicio</label>
          <input type="date" name="fecha_inicio" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Fecha Fin</label>
          <input type="date" name="fecha_fin" class="form-control" required>
        </div>
      </div>
      <div class="form-group">
        <label>Multiplicador de Precio</label>
        <input type="number" name="multiplicador" class="form-control" step="0.05" value="1.0" required>
        <div class="text-sm text-muted mt-2">Ej: 1.25 = 25% más caro, 0.85 = 15% descuento</div>
      </div>
      <div style="display:flex; gap:0.5rem; margin-top:1rem;">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar</button>
        <button type="button" class="btn btn-outline" onclick="document.getElementById('modalTemp').classList.remove('active')">Cancelar</button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
